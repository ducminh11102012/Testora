# Postgres. On Vercel, attaching a database in Storage sets this for you
# (POSTGRES_URL is read as well), so this file is only needed when self-hosting.
DATABASE_URL="postgres://user:password@host:5432/testora"

# Optional but recommended: signs the session cookie and derives the key that
# encrypts stored API keys. At least 32 random characters. Without it the key is
# derived from the connection string instead.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# AI is optional: without a key the importer falls back to the rule engine and
# writing goes to a human marker. The console (Platform → AI settings) can set
# all of this instead, and what is set there wins.
AI_PROVIDER="anthropic"          # anthropic | openai | google | custom | none
ANTHROPIC_API_KEY=""             # ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""                # OPENAI_MODEL="gpt-4o"
GOOGLE_API_KEY=""                # GOOGLE_MODEL="gemini-2.0-flash"

# Endpoint riêng: OpenRouter, Groq, DeepSeek, Azure OpenAI, vLLM, Ollama, hoặc
# proxy của trường. Đặt AI_PROVIDER="custom" (hoặc chỉ cần đặt AI_BASE_URL).
AI_BASE_URL=""                   # ví dụ https://openrouter.ai/api/v1, http://127.0.0.1:11434/v1
AI_MODEL=""                      # tên model đúng như endpoint yêu cầu
AI_API_KEY=""                    # để trống nếu endpoint không cần key
AI_WIRE="openai"                 # openai | anthropic | google — định dạng API của endpoint
AI_AUTH_STYLE="bearer"           # bearer | x-api-key | api-key | query | none

# Email là tuỳ chọn. Không có SMTP thì tài khoản chỉ cần username + mật khẩu.
# Cấu hình trong Platform → Email sẽ được ưu tiên hơn các biến dưới đây.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME=""

# Storage. Bình thường khai báo ở màn hình /setup và lưu vào data/root-storage.json.
# Chỉ cần các biến này khi máy chủ không ghi được đĩa (Vercel và các host serverless).

# Hugging Face — nơi lưu chính (dataset private).
HF_TOKEN=""
HF_REPO=""                # dạng namespace/name, ví dụ my-school/testora-private
# HF_REVISION="main"
# HF_ENDPOINT="https://huggingface.co"

# Cloudflare R2 / S3 — bản sao dự phòng, hoặc dùng làm nơi lưu chính nếu muốn.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT=""          # bucket S3-compatible khác thì điền cái này thay cho account id
# R2_REGION="auto"
# R2_PUBLIC_BASE_URL=""

# Đăng nhập và nối storage bằng Hugging Face (Settings → Connected Applications).
# Redirect URI phải đúng bằng https://<tên-miền>/api/auth/hf/callback
HF_OAUTH_CLIENT_ID=""
HF_OAUTH_CLIENT_SECRET=""   # để trống = public app, vẫn an toàn nhờ PKCE

# Cho job dọn file hết hạn (Vercel cron gửi kèm Authorization: Bearer $CRON_SECRET).
CRON_SECRET=""
