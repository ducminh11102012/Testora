{
  "name": "testora",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "setup": "npm install && npm run migrate && npm run seed",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "vercel-build": "next build",
    "verify": "npm run typecheck && tsx scripts/verify/checks.ts",
    "verify:checks": "tsx scripts/verify/checks.ts",
    "verify:browser": "tsx scripts/verify/browser.ts",
    "verify:all": "npm run verify && npm run verify:data && npm run verify:storage && npm run verify:wires && npm run verify:browser",
    "verify:data": "tsx --env-file-if-exists=.env scripts/verify/data.ts",
    "verify:wires": "tsx --env-file-if-exists=.env scripts/verify/wires.ts",
    "verify:storage": "tsx scripts/verify/storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@huggingface/hub": "^2.16.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "mammoth": "^1.8.0",
    "next": "14.2.18",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "smtp-server": "^3.19.4",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
